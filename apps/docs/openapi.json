          },
          "surname": {
            "type": "string",
            "title": "Surname"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "id",
          "forename",
          "surname",
          "email"
        ],
        "title": "User"
      },
      "UserCreate": {
        "properties": {
          "forename": {
            "type": "string",
            "title": "Forename"
          },
          "surname": {
            "type": "string",
            "title": "Surname"
          },
          "email": {
            "type": "string",
