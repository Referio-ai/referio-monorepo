{
  "version": 2,
  "builds": [
    {
      "src": "/src/main.py",
      "use": "@vercel/python",
      "config": {
      "excludeFiles": "/{.next,.cache,node_modules,public,app}/*"
      }
      
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.py"
    }
  ],
  "env": {
    "APP_MODULE": "src.main:app"
  }
}
